# Backend Environment Configuration (Placeholder Values Only)
NODE_ENV=development
PORT=4000
HOST=127.0.0.1

# MongoDB connection string (local MongoDB or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/CampusLostFound

# Strong random secret (at least 32 characters required in production)
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

# Explicit frontend origin(s) allowed by CORS (comma-separated for multiple)
FRONTEND_ORIGIN=http://localhost:5173

# Local upload directory for validated images (use object storage such as S3/Cloudinary for ephemeral hosts)
UPLOAD_DIR=uploads

# Password hashing cost and rate limits
BCRYPT_ROUNDS=12
RATE_LIMIT_AUTH_MAX=15
RATE_LIMIT_CLAIMS_MAX=20
